# ── Runtime ────────────────────────────────────────────────────────────────
RUNTIME__MODE=PAPER                    # HISTORICAL_BACKFILL | REPLAY | PAPER | LIVE
RUNTIME__SYMBOLS=["AAPL","TSLA","SPY","QQQ"]
RUNTIME__LOG_LEVEL=INFO
RUNTIME__TIMEZONE=America/New_York

# ── Database ────────────────────────────────────────────────────────────────
DB_USER=alpha
DB_PASSWORD=alpha_dev
DB_NAME=alpha_runtime
DB_HOST=localhost
DB_PORT=5432
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=alpha_runtime
DATABASE__USER=alpha
DATABASE__PASSWORD=alpha_dev
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE__PARQUET_ROOT=data/parquet

# ── Historical ──────────────────────────────────────────────────────────────
HISTORICAL__PRIMARY_SOURCE=polygon     # alpaca | polygon | csv | parquet
HISTORICAL__LOOKBACK_DAYS=30

# ── Live Feed ────────────────────────────────────────────────────────────────
LIVE__PRIMARY_SOURCE=alpaca            # alpaca | polygon | interactive_brokers

# ── Broker adapters (live / paper) ───────────────────────────────────────────
ALPACA__API_KEY=
ALPACA__SECRET_KEY=
ALPACA__BASE_URL=https://paper-api.alpaca.markets

POLYGON__API_KEY=

# ── Risk ────────────────────────────────────────────────────────────────────
RISK__ACCOUNT_SIZE=25000.00
RISK__MAX_DAILY_LOSS_PCT=0.02          # 2% of account
RISK__MAX_POSITION_RISK_PCT=0.01       # 1% per trade
RISK__MAX_OPEN_POSITIONS=5

# ── API ─────────────────────────────────────────────────────────────────────
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=false

# ── Replay ──────────────────────────────────────────────────────────────────
REPLAY__SPEED=1.0                      # 1.0 = real-time, 10.0 = 10x
REPLAY__START_DATE=2024-01-02
REPLAY__END_DATE=2024-12-31
